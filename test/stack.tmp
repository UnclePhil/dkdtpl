version: "3.5"
services:
    caddy-controller:
        configs:
            - source: caddyfile
              target: /tmp/caddyfile
        deploy:
            placement:
                constraints:
                    - node.role == manager
            resources:
                limits:
                    memory: 128M
                reservations:
                    memory: 64M
            restart_policy:
                condition: on-failure
            update_config:
                delay: 10s
                order: start-first
                parallelism: 1
        environment:
            - CADDY_DOCKER_MODE=controller
            - CADDY_CONTROLLER_NETWORK=10.200.200.0/24
            - CADDY_DOCKER_CADDYFILE_PATH=/tmp/caddyfile
            - CADDY_INGRESS_NETWORKS=proxy
            - CLUSTER_DOMAIN=${CLUSTER_DOMAIN}
            - CLUSTER_NAME=${CLUSTER_NAME}
        image: unclephil/caddy-docker-proxy:2.7.5-redis
        networks:
            - proxy
            - caddycontrol
        volumes:
            - /var/run/docker.sock:/var/run/docker.sock
    caddy-server:
        deploy:
            labels:
                - caddy_controlled_server=
            mode: global
            resources:
                limits:
                    memory: 256M
                reservations:
                    memory: 64M
            restart_policy:
                condition: on-failure
            update_config:
                delay: 10s
                order: start-first
                parallelism: 1
        environment:
            - CADDY_DOCKER_MODE=server
            - CADDY_CONTROLLER_NETWORK=10.200.200.0/24
            - CLUSTER_DOMAIN=${CLUSTER_DOMAIN}
            - CLUSTER_NAME=${CLUSTER_NAME}
        image: unclephil/caddy-docker-proxy:2.7.5-redis
        networks:
            - proxy
            - caddycontrol
        ports:
            - 80:80
            - 443:443
        secrets:
            - source: cakey
              target: /data/caddy/pki/authorities/local/root.key
            - source: cacert
              target: /data/caddy/pki/authorities/local/root.crt
        volumes:
            - ${CLUSTER_VOL}caddy:/data
networks:
    caddycontrol:
        driver: overlay
        ipam:
            config:
                - subnet: 10.200.200.0/24
            driver: default
    proxy:
        external: true
volumes:
    caddy:
        driver: rclone
        driver_opts:
            - remote='s3fs:${CLUSTER_NAME}/data'
            - allow_other='true'
            - vfs_cache_mode=full
            - poll_interval=0
    toto:
        driver: local
configs:
    caddyfile:
        file: ./config/caddyfileCA
        name: caddyfile.1b3bbe6a208b94e4535dd222a0c79c23
secrets:
    cacert:
        file: ./secret/pkoCA.cert.pem
        name: cacert.c858d7fdfbb238c1b9fef3437af72510
    cakey:
        file: ./secret/pkoCA.key.pem
        name: cakey.119d67fb793e3cbdd6d9a8ddd939a1de
